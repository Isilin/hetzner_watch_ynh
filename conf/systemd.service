[Unit]
Description=hetzner_watch - surveillance de la disponibilité des serveurs Hetzner Cloud
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__/
EnvironmentFile=__INSTALL_DIR__/hetzner_watch.env
ExecStart=/usr/bin/python3 -m hetzner_watch
Restart=on-failure
RestartSec=30
# exit 2 = token refusé ou configuration invalide : inutile de relancer en boucle.
# Le config panel redémarre le service après correction.
RestartPreventExitStatus=2
TimeoutStopSec=10
Nice=10
MemoryMax=64M

# Durcissement : accès réseau sortant uniquement, écriture limitée au dossier de données
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=__DATA_DIR__
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
